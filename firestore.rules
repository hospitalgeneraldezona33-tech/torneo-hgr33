rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /userProfiles/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /teams/{teamId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        // Un equipo nuevo nunca puede nacer ya validado/rechazado.
        && request.resource.data.status in ['BORRADOR', 'PENDIENTE DE VALIDACIÓN'];

      allow read: if request.auth != null
        && (resource.data.ownerUid == request.auth.uid || isAdmin());

      // El administrador puede modificar libremente (validar, rechazar, anotar observaciones).
      allow update: if isAdmin();

      // El capitán (dueño) solo puede editar su propio equipo, y solo mientras NO manipule
      // los campos que son competencia exclusiva del administrador: no puede auto-validarse,
      // ni cambiar su folio una vez asignado, ni tocar la nota/validación del administrador.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status in ['BORRADOR', 'PENDIENTE DE VALIDACIÓN']
        && request.resource.data.folio == resource.data.folio
        && request.resource.data.get('validatedAt', null) == resource.data.get('validatedAt', null)
        && request.resource.data.get('validatedBy', null) == resource.data.get('validatedBy', null);

      allow delete: if isAdmin();
    }

    // Contador transaccional usado para generar folios consecutivos sin duplicados (HGR33-VAR-001, HGR33-FEM-001...).
    match /counters/{prefix} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.value == 1;
      allow update: if request.auth != null
        && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
